# Application Configuration
VITE_APP_TITLE=VATClear

# Firebase Configuration (Required)
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=your-api-key
# In production, use your own domain (e.g. thetaxapp.vercel.app) so Google sign-in works in Safari;
# see "Google sign-in on Safari/iOS" in the README
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id

# Set to true to use the local Firebase emulators (npm run emulators) instead of the real project
VITE_USE_FIREBASE_EMULATORS=false

# Server-side only (Vercel project settings): never prefix these with VITE_
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b
# FIREBASE_PROJECT_ID=your-project-id

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholders with your Firebase web app config
# 3. For Vercel deployment, add these as Environment Variables in project settings
