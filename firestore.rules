rules_version = '2';

// Each user's data lives under users/{uid}: the profile is that document, and customers,
// invoices, expenses, vatReturns (filed returns), branding (the invoice letterhead),
// recurringInvoices (templates) and bankTransactions (imported statement lines) are
// subcollections of it. Only the signed-in owner can read or write anything there; everything
// else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read, write: if isOwner(uid)
          && collection in ['customers', 'invoices', 'expenses', 'vatReturns', 'branding', 'recurringInvoices', 'bankTransactions'];
      }
    }
  }
}
