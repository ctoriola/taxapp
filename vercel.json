{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai-insights.ts": {
      "maxDuration": 30
    },
    "api/admin.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/__/(auth|firebase)/(.*)",
      "dest": "https://taxapp-f184c.firebaseapp.com/__/$1/$2"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
